{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Multi-Agent Orchestration (Target)",
    "subtitle": "local claims, precedent recall, global arbitration, bounded critique",
    "output": "multi-agent-orchestration.html",
    "viewBox": [1500, 720]
