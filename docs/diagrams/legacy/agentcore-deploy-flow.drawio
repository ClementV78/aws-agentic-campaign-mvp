        <mxCell id="105" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#8ee3a3;" edge="1" parent="1" source="22" target="24">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="106" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#8ee3a3;" edge="1" parent="1" source="23" target="25">
          <mxGeometry relative="1" as="geometry"/>
