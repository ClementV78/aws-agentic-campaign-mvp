        <mxCell id="3" value="Goal: deploy the AWS agentic POC in a repeatable order with clear rollback boundaries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#f0b44c;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
