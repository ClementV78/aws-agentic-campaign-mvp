    { "id": "gateway", "type": "security", "label": "Gateway", "sublabel": "AgentCore tools surface" },
    { "id": "policy", "type": "security", "label": "Policy", "sublabel": "guardrails + interceptors" },
    { "id": "tools", "type": "cloud", "label": "Tool Backends", "sublabel": "weather/events/mobility/refs" },
    { "id": "core", "type": "backend", "label": "Core", "sublabel": "CityContext + scoring" },
    { "id": "bedrock", "type": "cloud", "label": "Bedrock", "sublabel": "reasoning tiers" },
    { "id": "memory", "type": "database", "label": "Memory", "sublabel": "optional episodic recall" }
  ],
  "segments": [
    { "from": 170, "to": 250, "label": "01 / ENTRYPOINT" },
    { "from": 250, "to": 560, "label": "02 / CONTEXT TOOL CALLS" },
    { "from": 560, "to": 735, "label": "03 / DETERMINISTIC CORE" },
    { "from": 735, "to": 980, "label": "04 / LLM ARBITRATION" },
    { "from": 980, "to": 1080, "label": "05 / RESPONSE" }
  ],
  "messages": [
    { "from": "client", "to": "runtime", "y": 205, "label": "InvokeAgentRuntime(payload)", "variant": "emphasis" },
    { "from": "runtime", "to": "strands", "y": 238, "label": "init run agent", "variant": "default" },

    { "from": "strands", "to": "gateway", "y": 300, "label": "request get_weather / get_events / get_mobility / refs", "variant": "emphasis" },
    { "from": "gateway", "to": "policy", "y": 336, "label": "authorize + inspect request", "variant": "security" },
    { "from": "policy", "to": "gateway", "y": 370, "label": "allow / block / redact", "variant": "return" },
    { "from": "gateway", "to": "tools", "y": 408, "label": "invoke backend implementation", "variant": "default" },
    { "from": "tools", "to": "gateway", "y": 446, "label": "raw signals", "variant": "return" },
    { "from": "gateway", "to": "policy", "y": 482, "label": "inspect tool response", "variant": "security" },
    { "from": "policy", "to": "gateway", "y": 516, "label": "allow / redact / warn", "variant": "return" },
    { "from": "gateway", "to": "strands", "y": 550, "label": "governed tool results", "variant": "return" },

    { "from": "strands", "to": "core", "y": 610, "label": "build CityContext + compute scores", "variant": "emphasis" },
    { "from": "core", "to": "strands", "y": 648, "label": "ranked candidates + constraints", "variant": "return" },
    { "from": "strands", "to": "memory", "y": 688, "label": "optional episodic search", "variant": "dashed" },
    { "from": "memory", "to": "strands", "y": 720, "label": "matched episodes", "variant": "return" },

    { "from": "strands", "to": "bedrock", "y": 780, "label": "advertiser claims", "variant": "default", "note": "LLM roles consume deterministic results instead of replacing them" },
    { "from": "bedrock", "to": "strands", "y": 814, "label": "claims", "variant": "return" },
    { "from": "strands", "to": "bedrock", "y": 850, "label": "global arbitration", "variant": "emphasis" },
    { "from": "bedrock", "to": "strands", "y": 884, "label": "allocation plan", "variant": "return" },
    { "from": "strands", "to": "bedrock", "y": 920, "label": "review critique (bounded)", "variant": "default" },
    { "from": "bedrock", "to": "strands", "y": 954, "label": "approve / reject", "variant": "return" },

    { "from": "strands", "to": "runtime", "y": 1015, "label": "final plan + warnings + summary", "variant": "return" },
    { "from": "runtime", "to": "client", "y": 1050, "label": "JSON recommendation", "variant": "return" }
  ],
  "activations": [
    { "participant": "runtime", "from": 190, "to": 1035, "type": "backend" },
    { "participant": "strands", "from": 230, "to": 1022, "type": "backend" },
    { "participant": "gateway", "from": 290, "to": 562, "type": "backend" },
    { "participant": "core", "from": 602, "to": 655, "type": "backend" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Primary path",
      "items": [
        "InvokeAgentRuntime is the main MVP entrypoint",
        "API Gateway is only an optional HTTP facade",
